+  /* Restore z/OS file tag attributes */
+  {
+    attrib_t attr;
+    unsigned short ccsid;
+    unsigned int txtflag;
+
+    /* If tags were stored in the archive, use them.
+       Otherwise, set reasonable defaults for files from non-z/OS systems. */
+    if (st->zos_ccsid != 0 || st->zos_txtflag != 0)
+      {
+        /* Tags were preserved in the archive */
+        ccsid = st->zos_ccsid;
+        txtflag = st->zos_txtflag;
+      }
+    else
+      {
+        /* No tags in archive - apply defaults for files from non-z/OS systems.
+           Default to ISO8859-1 (CCSID 819) which is ASCII-compatible and
+           commonly used for Linux/Unix text files. */
+        if (typeflag == REGTYPE || typeflag == AREGTYPE || typeflag == CONTTYPE)
+          {
+            /* Regular file - tag as ISO8859-1 (ASCII-compatible) */
+            ccsid = 819;  /* ISO8859-1 */
+            txtflag = 1;  /* Text file */
+          }
+        else
+          {
+            /* Non-regular files (directories, symlinks, etc.) - don't tag */
+            ccsid = 0;
+            txtflag = 0;
+          }
+      }
+
+    /* Only set tags if we have a non-zero CCSID */
+    if (ccsid != 0)
+      {
+        memset (&attr, 0, sizeof (attr));
+        attr.att_filetagchg = 1;
+        attr.att_filetag.ft_ccsid = ccsid;
+        attr.att_filetag.ft_txtflag = txtflag;
+
+        if (fd >= 0)
+          {
+            /* Use file descriptor if available */
+            if (__fchattr (fd, &attr, sizeof (attr)) != 0)
+              {
+                ERROR ((0, errno, _("%s: Cannot set file tag attributes"),
+                        quotearg_colon (file_name)));
+              }
+          }
+        else
+          {
+            /* Fall back to path-based call */
+            if (__chattr (file_name, &attr, sizeof (attr)) != 0)
+              {
+                ERROR ((0, errno, _("%s: Cannot set file tag attributes"),
+                        quotearg_colon (file_name)));
+              }
+          }
+      }
+  }
+#endif
 }
 
